{
	"name": "image-text-wrap",
	"version": "0.1.0",
	"description": "Word-style text wrapping for images in Obsidian: a picture toolbar, drag to move, and matching output in Live Preview, Reading view and PDF.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"images",
		"text wrap"
	],
	"author": "tyler21richards",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint/js": "^9.39.5",
		"@lezer/common": "^1.5.3",
		"@types/node": "^22.20.5",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"playwright-core": "^1.64.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1"
	}
}
